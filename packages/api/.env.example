# nbins API server configuration.
# Copy to packages/api/.env (read automatically when the server or CLI starts
# in packages/api), or point NBINS_ENV_FILE at another file, e.g. /etc/nbins/nbins.env.
# Variables already set in the environment win over this file.

# development | staging | production. Production refuses to start without JWT_SECRET
# and disables the /api/dev routes.
APP_ENV=development
APP_NAME=nbins

# Listen address. Keep 127.0.0.1 and let nginx face the network.
NBINS_HOST=127.0.0.1
NBINS_PORT=8787

# Data. NBINS_DATA_DIR is the base for the three paths below; each can be set on its own.
# Relative paths are resolved against the working directory (packages/api for pnpm scripts).
NBINS_DATA_DIR=./data
# NBINS_DB_PATH=/var/lib/nbins/nbins.db
# NBINS_STORAGE_DIR=/var/lib/nbins/storage
# NBINS_BACKUP_DIR=/var/backups/nbins

# Apply pending schema migrations when the server starts (true/false).
NBINS_AUTO_MIGRATE=true

# Serve the built web app from this server too (optional; nginx usually does it).
# NBINS_WEB_DIST=/opt/nbins/packages/web/dist
# NBINS_WEB_BASE=/nbins/

# Secret for signing login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Admin SQL console: leave empty to keep it disabled.
SQL_CONSOLE_SECRET=

# Optional webhook called when an NCR is created.
N8N_WEBHOOK_URL=

# Extra allowed CORS origins, comma separated (not needed when nginx serves web + API on one origin).
NBINS_CORS_ORIGINS=
