{
  "name": "nbins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nbins/api --filter @nbins/web dev",
    "dev:web": "pnpm --filter @nbins/web dev",
    "dev:api": "pnpm --filter @nbins/api dev",
    "build": "pnpm -r build",
    "build:nbins": "pnpm --filter @nbins/api build && pnpm --filter @nbins/web build:nbins",
    "start": "pnpm --filter @nbins/api start",
    "db:init": "pnpm --filter @nbins/api db:init",
    "db:migrate": "pnpm --filter @nbins/api db:migrate",
    "db:check": "pnpm --filter @nbins/api db:check",
    "db:backup": "pnpm --filter @nbins/api db:backup",
    "db:import-d1": "pnpm --filter @nbins/api db:import-d1",
    "db:gen": "pnpm --filter @nbins/api db:gen",
    "test:api": "pnpm --filter @nbins/api test",
    "test:web": "pnpm --filter @nbins/web test",
    "qa": "pnpm typecheck && pnpm build && pnpm test:api",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@types/exceljs": "^1.3.2",
    "exceljs": "^4.4.0"
  }
}
